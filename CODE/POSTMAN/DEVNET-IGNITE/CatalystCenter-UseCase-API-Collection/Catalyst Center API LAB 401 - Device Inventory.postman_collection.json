  "item": [
    {
      "name": "CC Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);\r",
              "if (jsonData.Token) {\r",
              "    pm.test(\"Token acquired\",() => {pm.expect(pm.response.text()).to.include(\"Token\");});\r",
              "    pm.environment.set(\"TOKEN\", jsonData[\"Token\"]); \r",
              "}\r",
              "else {\r",
              "    pm.test(\"Token not acquired\",() => {pm.expect(pm.response.text()).to.include(\"Token\");});\r",
              "    postman.setNextRequest(\"null\");\r",
              "}\r",
              "postman.setNextRequest(\"Get Devices\")"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": {
        "strictSSL": false
      },
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "{{CCpwd}}",
              "type": "string"
            },
            {
              "key": "username",
              "value": "{{CCuser}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "https://{{CCip}}/dna/system/api/v1/auth/token",
          "protocol": "https",
          "host": [
            "{{CCip}}"
          ],
          "path": [
            "dna",
            "system",
            "api",
            "v1",
            "auth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Devices",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);",
              "var Device;",
              "let iterationValue = pm.iterationData.get(\"HierarchyParent\");",
              "if (iterationValue) {",
              "    //console.log(\"CSV data file is being used.\");",
              "    var DeviceList = pm.iterationData.get(\"DeviceList\");",
              "\tif (DeviceList.length > 0) {",
              "\t    console.log(\"Devices in POD: \",DeviceList);",
              "\t\tfor (var i = 0; i < jsonData.response.length; i++) {",
              "\t\t    if (DeviceList.includes(jsonData[\"response\"][i][\"managementIpAddress\"])) {",
              "\t\t        Hostname = jsonData[\"response\"][i][\"hostname\"].split(\".\");",
              "\t\t        if (Hostname[0].length < 20) {",
              "\t\t            Filler = 20 - Hostname[0].length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t                Hostname[0] = Hostname[0] + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        Address = jsonData[\"response\"][i][\"managementIpAddress\"]",
              "\t\t        if (Address.length < 20) {",
              "\t\t            Filler = 20 - Address.length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t            Address = Address + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        Pid = jsonData[\"response\"][i][\"platformId\"]",
              "\t\t        if (Pid.length < 20) {",
              "\t\t            Filler = 20 - Pid.length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t             Pid = Pid + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        Serial = jsonData[\"response\"][i][\"serialNumber\"]",
              "\t\t        if (Serial.length < 20) {",
              "\t\t            Filler = 20 - Serial.length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t                Serial = Serial + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        Version = jsonData[\"response\"][i][\"softwareVersion\"]",
              "\t\t        if (Version.length < 20) {",
              "\t\t            Filler = 20 - Version.length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t                Version = Version + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        UpTime = jsonData[\"response\"][i][\"upTime\"]",
              "\t\t        if (UpTime.length < 30) {",
              "\t\t            Filler = 30 - UpTime.length;",
              "\t\t            for (var f = 0; f < Filler; f++) {",
              "\t\t                UpTime = UpTime + \".\";",
              "\t\t            }",
              "\t\t        }",
              "\t\t        Device = Hostname[0] + \".\" + Address + \".\" + Pid + \".\" + Serial + \".\" + Version + \".\" + UpTime;",
              "\t\t        pm.test(\"\" + Device + \"\", () => { pm.expect(pm.response.text()).to.include(\"response\"); });",
              "\t\t        console.log(Device);",
              "\t\t    }",
              "\t\t}",
              "\t} ",
              "} else {",
              "    //console.log(\"No CSV data file is being used.\");",
              "    console.log(\"Devices in Lab: \");",
              "\tfor (var i = 0; i < jsonData.response.length; i++) {",
              "\t    Hostname = jsonData[\"response\"][i][\"hostname\"].split(\".\");",
              "\t    if (Hostname[0].length < 20) {",
              "\t        Filler = 20 - Hostname[0].length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t            Hostname[0] = Hostname[0] + \".\";",
              "\t        }",
              "\t    }",
              "\t    Address = jsonData[\"response\"][i][\"managementIpAddress\"]",
              "\t    if (Address.length < 20) {",
              "\t        Filler = 20 - Address.length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t        Address = Address + \".\";",
              "\t        }",
              "\t    }",
              "\t    Pid = jsonData[\"response\"][i][\"platformId\"]",
              "\t    if (Pid.length < 20) {",
              "\t        Filler = 20 - Pid.length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t         Pid = Pid + \".\";",
              "\t        }",
              "\t    }",
              "\t    Serial = jsonData[\"response\"][i][\"serialNumber\"]",
              "\t    if (Serial.length < 20) {",
              "\t        Filler = 20 - Serial.length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t            Serial = Serial + \".\";",
              "\t        }",
              "\t    }",
              "\t    Version = jsonData[\"response\"][i][\"softwareVersion\"]",
              "\t    if (Version.length < 20) {",
              "\t        Filler = 20 - Version.length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t            Version = Version + \".\";",
              "\t        }",
              "\t    }",
              "\t    UpTime = jsonData[\"response\"][i][\"upTime\"]",
              "\t    if (UpTime.length < 30) {",
              "\t        Filler = 30 - UpTime.length;",
              "\t        for (var f = 0; f < Filler; f++) {",
              "\t            UpTime = UpTime + \".\";",
              "\t        }",
              "\t    }",
              "\t    Device = Hostname[0] + \".\" + Address + \".\" + Pid + \".\" + Serial + \".\" + Version + \".\" + UpTime;",
              "\t    pm.test(\"\" + Device + \"\", () => { pm.expect(pm.response.text()).to.include(\"response\"); });",
              "\t    console.log(Device);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
