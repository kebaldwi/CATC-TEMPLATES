              "pm.environment.set(\"CommandRunnerResults\", body);",
              "pm.test(\"Show Command: /n\" + body,() => {pm.expect(pm.response.text());});",
              ""
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
