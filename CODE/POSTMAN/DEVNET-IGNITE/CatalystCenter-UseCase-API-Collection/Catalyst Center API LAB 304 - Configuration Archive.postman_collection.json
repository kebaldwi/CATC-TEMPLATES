{
  "info": {
    "_postman_id": "51977081-2f6d-4c51-829c-096453064d46",
    "name": "Catalyst Center API LAB 304 - Configuration Archive",
    "description": "This Collection is designed to download and extract the running and startup configurations of a switch within the network.\n\nPlease use the csv provided...\n\n[⬇︎ Catalyst Center Design Settings CSV ⬇︎](https://git-link.vercel.app/api/download?url=https://github.com/kebaldwi/DNAC-TEMPLATES/blob/master/CODE/POSTMAN/DEVNET-IGNITE/CCC-Design-Settings-v3.csv)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "13375428",
    "_collection_link": "https://go.postman.co/collection/13375428-51977081-2f6d-4c51-829c-096453064d46?source=collection_link"
  },
  "item": [
    {
      "name": "CC Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);\r",
              "if (jsonData.Token) {\r",
              "    pm.test(\"Token acquired\",() => {pm.expect(pm.response.text()).to.include(\"Token\");});\r",
              "    pm.environment.set(\"TOKEN\", jsonData[\"Token\"]); \r",
              "}\r",
              "else {\r",
              "    pm.test(\"Token not acquired\",() => {pm.expect(pm.response.text()).to.include(\"Token\");});\r",
              "    postman.setNextRequest(\"null\");\r",
              "}\r",
              "pm.environment.set(\"FLAG\", 0);\r",
              "postman.setNextRequest(\"Get Devices\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var setArray = [];\r",
              "pm.environment.set(\"ConfigurationFileId\", null);\r",
              "pm.environment.set(\"ConfigurationFileIdArray\", setArray);\r",
              "pm.environment.set(\"ConfigurationTaskIdArray\", setArray);\r",
              "pm.environment.set(\"ConfigurationTaskId\", null);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": {
        "strictSSL": false
      },
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "{{CCpwd}}",
              "type": "string"
            },
            {
              "key": "username",
              "value": "{{CCuser}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "https://{{CCip}}/dna/system/api/v1/auth/token",
          "protocol": "https",
          "host": [
            "{{CCip}}"
          ],
          "path": [
            "dna",
            "system",
            "api",
            "v1",
            "auth",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Devices",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);",
              "var DeviceList = pm.iterationData.get(\"DeviceList\");",
              "if (DeviceList.length > 0) {",
              "    var DeviceList = DeviceList.split(\",\");",
              "    var DeviceId = \"\";",
              "    var DeviceIp = \"\";",
              "    var FLAG = DeviceList.length;",
              "    pm.environment.set(\"FLAG\", FLAG);",
              "    for (var i = 0; i < jsonData.response.length; i++) {",
              "        for (var dl = 0; dl < DeviceList.length; dl++) {",
              "            if (jsonData[\"response\"][i][\"managementIpAddress\"] === DeviceList[dl]){",
              "                if (i === 0){",
              "                    TargetDeviceIp = jsonData[\"response\"][i][\"managementIpAddress\"]; ",
              "                    TargetDeviceId = jsonData[\"response\"][i][\"id\"];             }",
              "                else {",
              "                    TargetDeviceIp = TargetDeviceIp + \",\" + jsonData[\"response\"][i][\"managementIpAddress\"]; ",
              "                    TargetDeviceId = TargetDeviceId + \",\" + jsonData[\"response\"][i][\"id\"]; ",
              "                }",
              "            }",
              "        }",
              "    }",
              "    pm.test(\"Devices acquired\",() => {pm.expect(pm.response.text()).to.include(\"response\");});",
              "    pm.environment.set(\"TargetDeviceId\", TargetDeviceId);",
              "    pm.environment.set(\"TargetDeviceIp\", TargetDeviceIp);",
              "    console.log(\"Selected Devices: \" + TargetDeviceId);",
              "    setTimeout(function(){}, [1000]);",
              "    postman.setNextRequest(\"Get Configuration\");",
              "}",
              "else {",
              "    pm.test(\"Devices not acquired\",() => {pm.expect(pm.response.text()).to.include(\"response\");});",
              "    postman.setNextRequest(\"null\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Auth-Token",
            "value": "{{TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://{{CCip}}/dna/intent/api/v1/network-device",
          "protocol": "https",
          "host": [
            "{{CCip}}"
          ],
          "path": [
            "dna",
            "intent",
            "api",
            "v1",
            "network-device"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Configuration",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let d = pm.environment.get(\"TargetDeviceId\");",
              "let DeviceId = d.split(\",\");",
              "let arrayid = pm.environment.get(\"FLAG\") - 1",
              "pm.environment.set(\"TargetId\", DeviceId[arrayid]);",
              "pm.environment.get(\"ConfigZipFilePwd\");",
              ""
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);",
              "var taskId = \"\";",
              "let taskIdArray = pm.environment.get(\"ConfigurationTaskIdArray\");",
              "",
              "if (jsonData.response.taskId) {",
              "    pm.test(\"Configuration acquired\",() => {pm.expect(pm.response.text()).to.include(\"taskId\");});",
              "    taskId = jsonData.response.taskId;",
              "    if (taskIdArray != \"\") {",
              "        taskIdArray = taskIdArray + \",\" + taskId;",
              "    }",
              "    else {",
              "        taskIdArray = taskId;",
              "    }",
              "    postman.setEnvironmentVariable(\"ConfigurationTaskIdArray\", taskIdArray);",
              "    postman.setEnvironmentVariable(\"ConfigurationTaskId\", taskId);",
              "    console.log(\"Configuration Task Id: \" + taskId);",
              "    console.log(\"Configuration Task Id Array: \" + taskIdArray);",
              "}",
              "else {",
              "    pm.test(\"Configuration not acquired\",() => {pm.expect(pm.response.text()).to.include(\"taskId\");});",
              "    postman.setNextRequest(\"null\");",
              "}",
              "setTimeout(function(){}, [5000]);",
              "postman.setNextRequest(\"Get Task Id\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Auth-Token",
            "value": "{{TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"deviceId\": [ \"{{TargetId}}\" ],\n    \"password\": \"{{ConfigZipFilePwd}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://{{CCip}}/dna/intent/api/v1/network-device-archive/cleartext",
          "protocol": "https",
          "host": [
            "{{CCip}}"
          ],
          "path": [
            "dna",
            "intent",
            "api",
            "v1",
            "network-device-archive",
            "cleartext"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Task Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = JSON.parse(responseBody);",
              "let FLAG = pm.environment.get(\"FLAG\") - 1;",
              "var fileIdArray = pm.environment.get(\"ConfigurationFileIdArray\");",
              "",
              "if (jsonData.response.additionalStatusURL) {",
              "    pm.test(\"Configuration ready\",() => {pm.expect(pm.response.text()).to.include(\"additionalStatusURL\");});",
              "    fileId =  jsonData.response.additionalStatusURL;",
              "    if (fileIdArray != \"\") {",
              "        fileIdArray = fileIdArray + \",\" + fileId;",
              "    }",
              "    else {",
              "        fileIdArray = fileId;",
              "    }",
              "    postman.setEnvironmentVariable(\"ConfigurationFileIdArray\", fileIdArray);",
              "    postman.setEnvironmentVariable(\"ConfigurationFileId\", fileId);",
              "    console.log(\"Configuration File Id: \" + fileId);",
              "    console.log(\"Configuration File Id Array: \" + fileIdArray);",
              "}",
              "else {",
              "    pm.test(\"Configuration not ready\",() => {pm.expect(pm.response.text()).to.include(\"additionalStatusURL\");});",
              "    postman.setNextRequest(\"null\");",
              "}",
              "if (FLAG > 0 ){",
              "   pm.environment.set(\"FLAG\", FLAG);",
              "   setTimeout(function(){}, [25000]);",
              "   postman.setNextRequest(\"Get Configuration\"); ",
              "}",
              "else {",
              "   setTimeout(function(){}, [25000]);",
              "   postman.setNextRequest(\"Get Results\"); ",
              "}",
              ""
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.get(\"ConfigurationTaskId\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Auth-Token",
            "value": "{{TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "https://{{CCip}}/dna/intent/api/v1/task/{{ConfigurationTaskId}}",
          "protocol": "https",
          "host": [
            "{{CCip}}"
          ],
          "path": [
            "dna",
            "intent",
            "api",
            "v1",
            "task",
            "{{ConfigurationTaskId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Results",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Pre-request Script\r",
              "//\r",
              "// Which device do you want the configuration for?\r",
              "// Choose one:\r",
              "// 1. Router\r",
              "// 2. C9300-1\r",
              "// 3. C9300-2\r",
              "//\r",
              "// Enter your answer in the userChoice variable in the Global Environment or \r",
              "// change the default below\r",
              "\r",
              "if (!pm.environment.get(\"userChoice\")) {\r",
              "    // Default value or logic to set a default choice\r",
              "    pm.environment.set(\"userChoice\", \"1\"); // Set a default value\r",
              "}\r",
              "let userChoice = pm.environment.get(\"userChoice\");\r",
              "fileIdArray = pm.environment.get(\"ConfigurationFileIdArray\").split(\",\");\r",
              "fileId = fileIdArray[userChoice];\r",
              "pm.environment.set(\"ConfigurationFileId\", fileId);\r",
              ""
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = responseBody;",
              "let pwd = pm.environment.get(\"ConfigZipFilePwd\");",
              "pm.test(\"Please use \"+ pwd + \" to open file\",() => {pm.expect(pm.response.text()).to.include(\"STARTUP\");});",
              "let FLAG = pm.environment.get(\"FLAG\");",
              "if (FLAG > 1) {",
              "    FLAG = FLAG - 1;",
              "    pm.environment.set(\"FLAG\", FLAG);",
              "    postman.setNextRequest(\"Get Configuration\");",
              "}",
              "else {",
              "    FLAG = 0;",
              "    pm.environment.set(\"FLAG\", FLAG);",
              "    postman.setNextRequest(\"null\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "X-Auth-Token",
            "value": "{{TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://{{CCip}}{{ConfigurationFileId}}",
          "protocol": "https",
          "host": [
            "{{CCip}}{{ConfigurationFileId}}"
          ]
        }
      },
      "response": []
    }
  ]
}