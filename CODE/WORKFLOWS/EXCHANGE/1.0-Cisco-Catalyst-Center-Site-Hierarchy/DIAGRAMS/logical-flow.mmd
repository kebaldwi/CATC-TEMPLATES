flowchart TD
    START([Start]) --> A

    A["Step 1 - Get-GitHub-Directory-v2
    GET api.github.com/repos/{owner}/{repo}/contents/{path}
    X-GitHub-Api-Version: 2022-11-28  |  Auth: Basic"] --> B

    B["Step 2 - JSONPath Queries on Directory Response
    $.length()  -> NumberFiles
    $..name     -> GithubFileList array"] --> C

    C(["For each file in GithubFileList"]) --> D{File ==<br/>GITHUB-FILE<br/>settings.json?}
    D -->|No - skip| C
    D -->|Yes| E

    E["Step 3 - Get-GitHub-File-v2
    GET api.github.com/repos/{owner}/{repo}/contents/{path}/{file}
    Header: Accept: application/vnd.github.raw+json
    Returns: raw JSON content"] --> F

    F["Step 4a - JSONPath Queries on File Content
    $.length()  -> hierarchyLength
    $.project   -> ProjectJson full array"] --> G

    G["Step 4b - Read Table from JSON
    JSONPath: $.[*] -> HierarchyList table
    Columns: HierarchyParent | HierarchyArea
             HierarchyBldg   | HierarchyFloor"] --> H

    H(["For each row in HierarchyList"]) --> I

    I["Step 5a - JSONPath Queries
    Extract 5 hierarchy fields for current row
    Parent, Area, Building, Floor, BuildingAddress"] --> J1

    subgraph STEP5B["Step 5b - Resolved Hierarchy Inputs"]
        direction TB
        J1["HierarchyParent
        Parent area path root"] --> J2
        J2["HierarchyArea
        Area name to create/check"] --> J3
        J3["HierarchyBldg
        Building name and parent area"] --> J4
        J4["HierarchyFloor + HierarchyBldgAddress
        Floor name and building address"]
    end

    subgraph STEP5C["Step 5c - CATC-BuildHierarchy-v3"]
        direction TB
        K1["1) GET /dna/intent/api/v1/site
        Read full existing site hierarchy snapshot"] --> K2
        K2["2) Parent check
        Find Parent string in hierarchy JSON
        If missing: Split parent path + POST /dna/intent/api/v1/site type=area
        Poll execution status by ID"] --> K3
        K3["3) Area check
        Find Parent/Area path
        If missing: POST /dna/intent/api/v1/site type=area
        Poll execution status by ID"] --> K4
        K4["4) Building check
        Find Parent/Area/Building path
        If missing: POST /dna/intent/api/v1/site type=building
        Body includes address + parentName
        Poll execution status by ID"] --> K5
        K5["5) Floor check
        Find Parent/Area/Building/Floor path
        If missing: POST /dna/intent/api/v1/site type=floor
        Body includes rfModel and dimensions
        Poll execution status by ID"] --> K6
        K6["6) GET /dna/intent/api/v2/site
        Return resultant site hierarchy response"]
    end

    J4 --> K1
    K6 --> L{Hierarchy<br/>build and result<br/>retrieval OK?}
    L -->|No| FAIL_A([Fail: CATC-BuildHierarchy-v3<br/>returned error])
    L -->|Yes| M{More rows<br/>in HierarchyList?}

    M -->|Yes| H
    M -->|No| N

    N["Step 6 - Sleep 30 Seconds
    Allow CatC hierarchy updates to settle"] --> DONE([Done])

    style FAIL_A fill:#c0392b,color:#fff,stroke:#922b21
    style DONE fill:#27ae60,color:#fff,stroke:#1e8449
    style START fill:#2980b9,color:#fff,stroke:#1a5276
