flowchart TD
    START([Start]) --> A

    A["Step 1 — Get-GitHub-Directory-v2
    GET api.github.com/repos/{owner}/{repo}/contents/{path}
    X-GitHub-Api-Version: 2022-11-28  |  Auth: Basic"] --> B

    B["Step 2 — JSONPath Queries on Directory Response
    $.length()  → NumberFiles
    $..name     → GithubFileList array"] --> C

    C(["For each file in GithubFileList"]) --> D{File ==<br/>GITHUB-FILE<br/>settings.json?}
    D -->|No — skip| C
    D -->|Yes| E

    E["Step 3 — Get-GitHub-File-v2
    GET api.github.com/repos/{owner}/{repo}/contents/{path}/{file}
    Header: Accept: application/vnd.github.raw+json
    Returns: raw JSON content"] --> FA

    FA["Step 4a — JSONPath Queries on File Content
    $.length()  → hierarchyLength
    $.project   → ProjectJson full array"] --> FB

    FB["Step 4b — Read Table from JSON
    JSONPath: $.[*]  →  HierarchyList table
    Columns: HierarchyParent | HierarchyArea
             HierarchyBldg   | HierarchyFloor"] --> H

    H(["For each row in HierarchyList"]) --> SA

    SA["Step 5a — Replace String
    null → '' in ProjectJson
    Prevents downstream JSONPath failures"] --> SB1

    subgraph STEP5B["Step 5b — JSONPath Queries — Extract 35 Fields"]
        direction TB
        SB1["Hierarchy
        HierarchyParent, HierarchyArea, HierarchyBldg, HierarchyFloor"] --> SB2
        SB2["Network Settings
        DNS: primary_ip, secondary_ip, domain_name
        DHCP: dhcp_server array
        NTP: ntp_server array
        Timezone: timezone string
        MOTD: banner_message, retain_existing_banner"] --> SB3
        SB3["Monitoring
        SNMP: ip_addresses array, configure_dnac_ip
        Syslog: ip_addresses array, configure_dnac_ip
        Netflow: ip_address, port (default 2055), configure_dnac_ip"] --> SB4
        SB4["AAA and Device Credentials
        AAA: server_type, primary/secondary IP, protocol, shared_secret, pan_address
        CLI: description, username, password, enable_password
        SNMP v2c Read: description, read_community
        SNMP v2c Write: description, write_community
        NETCONF: description, netconf_port"]
    end

    subgraph STEP5C["Step 5c — CATC-AssignSettings-v2"]
        direction TB
        K1["① POST /dna/intent/api/v1/network/{siteId}
        Apply: DNS, DHCP, NTP, SNMP, Syslog
               Netflow, MOTD, Timezone, AAA"] --> K2
        K2["② GET /dna/intent/api/v1/global-credential
        Check: existing CLI, SNMP v2c, NETCONF creds
        Compares description labels to detect duplicates"] --> K3
        K3["③ POST /dna/intent/api/v1/global-credential
        Create: CLI credential (user/pass/enable)
                SNMP v2c Read, SNMP v2c Write
                NETCONF port credential"] --> K4
        K4["④ POST /dna/intent/api/v2/site/{siteId}/credential
        Assign: all credentialIds to target site
        Effect: active for all devices at this hierarchy level"]
    end

    SB4 --> K1
    K4 --> L{Settings and<br/>credentials<br/>applied OK?}
    L -->|No| FAIL_A([Fail: CATC-AssignSettings<br/>returned error])
    L -->|Yes| M{More rows<br/>in HierarchyList?}

    M -->|Yes| H
    M -->|No| N

    N["Step 6 — Sleep 30 Seconds
    Allow CatC time to propagate
    network settings across site"] --> DONE([Done])

    style FAIL_A fill:#c0392b,color:#fff,stroke:#922b21
    style DONE fill:#27ae60,color:#fff,stroke:#1e8449
    style START fill:#2980b9,color:#fff,stroke:#1a5276
