                "properties": {
                  "action_timeout": 180,
                  "continue_on_failure": false,
                  "description": "Extract Responses",
                  "display_name": "Extract Responses",
                  "script": "import sys\nimport json\nimport re\n\n#Set Variables\njson_response = (sys.argv[1])\nCOMMANDS = (sys.argv[2])\nNO_OUTPUT_MARKER = \"No-Matching-Output\"\n\n#Definitions\ndef extract_command_outputs(response: dict, commands: list) -> dict:\n    results = {cmd: NO_OUTPUT_MARKER for cmd in commands}\n    # 1. Pull the error message string\n    error_message = response.get(\"output\", {}).get(\"error\", {}).get(\"message\", \"\")\n    if not error_message:\n        return results\n    # 2. Locate the embedded JSON array starting at 'body=['\n    match = re.search(r\"body=(\\[.*\\])\\s*$\", error_message, re.DOTALL)\n    if not match:\n        return results\n    try:\n        body_data = json.loads(match.group(1))\n    except json.JSONDecodeError as e:\n        print(f\"[!] Failed to parse embedded JSON body: {e}\")\n        return results\n    # 3. Walk through SUCCESS section and clean each command output\n    for entry in body_data:\n        success_block = entry.get(\"commandResponses\", {}).get(\"SUCCESS\", {})\n        for cmd in commands:\n            raw_output = success_block.get(cmd, \"\")\n            cleaned = clean_output(raw_output, cmd)\n            results[cmd] = cleaned if cleaned else NO_OUTPUT_MARKER\n    return results\ndef clean_output(raw: str, command: str) -> str:\n    if not raw:\n        return \"\"\n    lines = raw.splitlines()\n    # Strip the first line if it's just the echoed command\n    if lines and lines[0].strip() == command.strip():\n        lines = lines[1:]\n    # Strip the trailing prompt line (anything ending with '#' or '>')\n    if lines and re.match(r\"^\\S+[#>]\\s*$\", lines[-1].strip()):\n        lines = lines[:-1]\n    # Remove blank lines around the result\n    cleaned = \"\\n\".join(line for line in lines if line.strip())\n    return cleaned.strip()\ndef build_report_string(extracted: dict) -> str:\n    parts = []\n    parts.append(\"=\" * 70)\n    parts.append(\"EXTRACTED COMMAND OUTPUTS\")\n    parts.append(\"=\" * 70)\n    for cmd, output in extracted.items():\n        parts.append(\"\")                       # blank line before each command\n        parts.append(f\">>> Command: {cmd}\")\n        parts.append(\"-\" * 70)\n        parts.append(output)\n    # Join everything with newlines into ONE string\n    return \"\\n\".join(parts)\n#Main\nextracted = extract_command_outputs(json_response, COMMANDS)\nreport_str = build_report_string(extracted)\n\n",
