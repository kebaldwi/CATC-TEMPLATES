                  "continue_on_failure": false,
                  "description": "Extract Responses",
                  "display_name": "Extract Responses",
                  "script": "import sys\nimport json\nimport re\n\n# ---------------------------------------------------------------\n# Set Variables\n# ---------------------------------------------------------------\nraw_arg1 = sys.argv[1]\nraw_arg2 = sys.argv[2]\nNO_OUTPUT_MARKER = \"No-Matching-Output\"\n\n# argv[1]: may be raw error message string OR a wrapping JSON dict\ntry:\n    parsed = json.loads(raw_arg1)\n    json_response = parsed if isinstance(parsed, dict) else {\"output\": {\"error\": {\"message\": raw_arg1}}}\nexcept Exception:\n    json_response = {\"output\": {\"error\": {\"message\": raw_arg1}}}\n\n# argv[2]: JSON list of commands\ntry:\n    COMMANDS = json.loads(raw_arg2)\n    if not isinstance(COMMANDS, list):\n        raise ValueError\nexcept Exception:\n    COMMANDS = [c.strip().strip('\"').strip(\"'\") for c in raw_arg2.split(\",\") if c.strip()]\n\n\n# ---------------------------------------------------------------\n# Definitions\n# ---------------------------------------------------------------\ndef clean_output(raw: str, command: str) -> str:\n    if not raw:\n        return \"\"\n    lines = raw.splitlines()\n    if lines and lines[0].strip() == command.strip():\n        lines = lines[1:]\n    if lines and re.match(r\"^\\S+[#>]\\s*$\", lines[-1].strip()):\n        lines = lines[:-1]\n    return \"\\n\".join(l for l in lines if l.strip()).strip()\n\n\ndef extract_command_outputs(response: dict, commands: list) -> dict:\n    results = {cmd: NO_OUTPUT_MARKER for cmd in commands}\n\n    error_message = response.get(\"output\", {}).get(\"error\", {}).get(\"message\", \"\")\n    if not error_message:\n        return results\n\n    match = re.search(r\"body=(\\[.*\\])\\s*$\", error_message, re.DOTALL)\n    if not match:\n        return results\n\n    body_text = match.group(1)\n\n    # 🔧 Escape raw control characters that break json.loads\n    body_text = re.sub(r'(?<!\\\\)\\n', r'\\\\n', body_text)\n    body_text = re.sub(r'(?<!\\\\)\\r', r'\\\\r', body_text)\n    body_text = re.sub(r'(?<!\\\\)\\t', r'\\\\t', body_text)\n\n    try:\n        body_data = json.loads(body_text)\n    except json.JSONDecodeError as e:\n        print(f\"[!] Failed to parse embedded JSON body: {e}\")\n        return results\n\n    for entry in body_data:\n        success_block = entry.get(\"commandResponses\", {}).get(\"SUCCESS\", {})\n        for cmd in commands:\n            raw_output = success_block.get(cmd, \"\")\n            cleaned = clean_output(raw_output, cmd)\n            results[cmd] = cleaned if cleaned else NO_OUTPUT_MARKER\n    return results\n\n\ndef build_report_string(extracted: dict) -> str:\n    parts = [\"=\" * 70, \"EXTRACTED COMMAND OUTPUTS\", \"=\" * 70]\n    for cmd, output in extracted.items():\n        parts += [\"\", f\">>> Command: {cmd}\", \"-\" * 70, output]\n    return \"\\n\".join(parts)\n\n\n# ---------------------------------------------------------------\n# Main\n# ---------------------------------------------------------------\nextracted  = extract_command_outputs(json_response, COMMANDS)\nreport_str = build_report_string(extracted)\n\n# print(report_str)   # ← workflow engines capture stdout",
                  "script_arguments": [
