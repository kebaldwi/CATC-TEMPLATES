        "properties": {
          "atomic": {
            "atomic_group": "Core",
            "atomic_subgroup": "String Operations"
          },
          "continue_on_failure": false,
          "description": "Normalizes a single input string into a valid JSON array.\n\nSupported input formats:\n- Python/JSON list literals: [\"A\",\"B\"] or ['A','B']\n- Comma-separated values: A,B,C or \"A,B\",C\n- Newline-separated values: one item per line\n- Mixed: newline-separated lines where each line may contain comma-separated values\n\nProcessing rules:\n- Literal lists are returned unchanged\n- Non-literal input is split by newline, then each line is parsed with Python's csv module\n- Whitespace and surrounding quotes are stripped from each value\n- Empty values are discarded\n- Empty or whitespace-only input returns an empty array: []\n\nLimitation: \nCSV fields that span multiple lines inside quotes are not supported.",
          "display_name": "String to Array",
          "input": {
            "variable_workflow_02U2EAHX8D55H5UbMC1Gkzpc5YTXEvMXHFP": "$workflow.definition_workflow_02NJPN1YW6JOZ6YA6fZzjEh83q7jZFpfQiF.input.variable_workflow_02NJPN202YQ421Ls0XpkNQXWMgdZyYA0C6V$"
