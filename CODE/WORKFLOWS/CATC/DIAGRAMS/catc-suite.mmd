        B3["CATC-BrownFieldOnboarding-v3
        discover → normalise (tuned)"]
    end

    %% ===== Utility / read-only =====
    subgraph UTIL["Utilities"]
        direction TB
        U1["CATC-GetHierarchy"]
        U2["CATC-DeviceInventory"]
        U3["CATC-CommandRunner"]
        U4["CATC-PortConfiguration"]
