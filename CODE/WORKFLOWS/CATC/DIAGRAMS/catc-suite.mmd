    %% ===== Target =====
    CATCDC["Cisco Catalyst Center
    Intent API"]:::target

    %% Flow from GitHub
    GH --> GITOPS

    %% GitOps -> CATC building blocks
    G1 -.calls.-> C1
    G2 -.calls.-> C2
    G3 -.calls.-> C3
    G4 -.calls.-> C4
    G5 -.uses.-> C4
    G7 -.uses.-> C3

    %% Brown-field reuses the same blocks
    B2 -.uses.-> C1
    B2 -.uses.-> C2
    B2 -.uses.-> C3
    B2 -.uses.-> C4
    B3 -.uses.-> C1
    B3 -.uses.-> C2
    B3 -.uses.-> C3
    B3 -.uses.-> C4

    %% Utilities feed and inspect CatC
    U1 --> CATCDC
    U2 --> CATCDC
    U3 --> CATCDC
    U4 --> CATCDC

    %% All paths converge on CatC
    C1 --> CATCDC
    C2 --> CATCDC
    C3 --> CATCDC
    C4 --> CATCDC
    C5 --> CATCDC
    G5 --> CATCDC
    G6 --> CATCDC
    G7 --> CATCDC

