        C1["CATC-BuildHierarchy-v2"]
        C2["CATC-AssignSettings-v2"]
        C3["CATC-DeviceDiscovery"]
        C4["CATC-CreateTemplate-v2"]
        C5["CATC-GitHubIntegration-v2"]
    end

    %% ===== Brown-field composites =====
    subgraph BFO["Brown-Field Onboarding"]
